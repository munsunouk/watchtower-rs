WHITESPACE              = _{ " " | "\t" | "\n" }
arithmetic_operator     =  { "+" | "-" }
multiplicative_operator =  { "*" | "/" }
logical_operator        =  { "&&" | "||" }
comparison_operator     =  { ">=" | "<=" | "==" | "!=" | ">" | "<" }
boolean_literal         =  { "true" | "false" }

// Operators
expression = { operation ~ (logical_operator ~ operation)* }
operation  = { term ~ (comparison_operator ~ term)? }
term       = { factor ~ (arithmetic_operator ~ factor)* }
factor     = { primary ~ (multiplicative_operator ~ primary)* }
primary    = { boolean_literal | call_stmt | number | identifier | "(" ~ expression ~ ")" }

// specific identifiers
link              = { "BRP" }
blockchain        = { "Ethereum" | "Bifrost" | "Base" | "Kaia" }
service           = { "ChainlinkOracle" | "BifnetOracle" | "Bifagg" | "KlaytnChainlinkOracle" | "BaseChainlinkOracle" }
contract          = { "WBTC" | "BTC" | "BFC" | "BTCB" | "USDC" | "USDT" | "ETH" | "BTCBTCUSD" | "JPYBTCUSD" | "BTCBTCUSD" | "BNB" | "ETH" | "POL" | "DAI" | "BFC" | "BIFI" | "XRP" | "JPY" | "JPYEURO" | "EURO" | "LP_BTCUSDUSDC" | "WSTBFC" | "BTCUSD" }
call_target       = { "LatestPrice" }
blockchain_target = { "LatestBlock" | "EthBalance" | "UsdcBalance" | "UsdtBalance" | "BnbBalance" | "PolBalance" | "DaiBalance" | "BtcBalance" | "AggregatorBalance" | "AirdropBalance" | "Kaia_BtcBalance" | "Kaia_DaiBalance" | "Kaia_UsdtBalance" | "Kaia_UsdcBalance" | "Kaia_XrpBalance" | "Kaia_EthBalance" | "Kaia_UsdcBalance" | "BtcusdBalance" | "WsbfcBalance" | "JpyBalance" | "EuroBalance" | "Lp_Btcusdusdc" | "Base_Btcusd" | "Base_Jpybtcusd" }
rpc_target        = { "BTCTvl" }

params = { "(" ~ expression? ~ ")" }

// property
rpc_property        = { rpc_target ~ params }
contract_property   = { call_target ~ params }
blockchain_property = { blockchain_target ~ params }

identifier = @{ ASCII_ALPHANUMERIC ~ (ASCII_ALPHANUMERIC | "_")* }
number     = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

// call
rpc_call        = { link ~ "." ~ service ~ "." ~ rpc_property }
contract_call   = { blockchain ~ "." ~ service ~ "." ~ contract ~ "." ~ contract_property }
contract_event  = { blockchain ~ "." ~ service ~ "." ~ contract ~ "." ~ contract_property }
blockchain_call = { blockchain ~ "." ~ blockchain_property }

// Statements
call_stmt       = { rpc_call | contract_call | blockchain_call }
assignment_stmt = { WHITESPACE? ~ identifier ~ "=" ~ expression ~ ";" ~ WHITESPACE? }
expression_stmt = { WHITESPACE? ~ expression ~ ";" ~ WHITESPACE? }

// Program
program = _{ (assignment_stmt | expression_stmt)+ }
