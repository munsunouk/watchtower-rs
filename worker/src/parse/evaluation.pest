WHITESPACE              = _{ " " | "\t" | "\n" }
arithmetic_operator     =  { "+" | "-" }
multiplicative_operator =  { "*" | "/" }
logical_operator        =  { "&&" | "||" }
comparison_operator     =  { ">=" | "<=" | "==" | "!=" | ">" | "<" }
boolean_literal         =  { "true" | "false" }

// Operators
Expr      = { Condition ~ (logical_operator ~ Condition)* }
Condition = { When | Operation }
When      = { "when" ~ Operation ~ "then" ~ Operation ~ "else" ~ Operation }
Operation = { Term ~ (comparison_operator ~ Term)? }
Term      = { Factor ~ (arithmetic_operator ~ Factor)* }
Factor    = { Primary ~ (multiplicative_operator ~ Primary)* }
Primary   = { boolean_literal | CallStmt | Address | Number | Identifier | StringLiteral | "(" ~ Expr ~ ")" }

// specific identifiers
Notification             = { "Slack" }
Chain                    = { "Ethereum" | "BifrostTestnet" | "Bifrost" | "Base" | "Kaia" | "BNB_PUB" | "BNB" }
Service                  = { "ChainlinkOracle" | "BifnetOracle" | "Bifagg" | "Everdex" | "BRP" | "CCCP" | "BIFI" | "OracleManager" | "Internal" }
Contract                 = {
    "WBTC"
  | "BTC"
  | "BTCB"
  | "USDC"
  | "USDT"
  | "ETH"
  | "JPYBTCUSD"
  | "BTCBTCUSD"
  | "BNB"
  | "POL"
  | "DAI"
  | "BFC"
  | "BIFI"
  | "XRP"
  | "JPY"
  | "JPYEURO"
  | "EURO"
  | "LP_BTCUSDUSDC"
  | "WSTBFC"
  | "BTCUSD"
  | "SmartRouter"
  | "Poolinfo"
  | "Swap"
  | "TotalSupply"
  | "VaultAddress"
  | "CurrentRound"
  | "Socket"
  | "LendingPool"
  | "Registration"
  | "LessMajority"
  | "Feeder"
  | "Round"
  | "History"
  | "TimeFilter"
  | "Info"
  | "FeedTime"
}
ContractMethodName       = {
    "LatestPrice"
  | "Liquidity"
  | "SystemVault"
  | "Relayer"
  | "CurrentRound"
  | "Round"
  | "Timestamp"
  | "Decision"
  | "LastTimestamp"
  | "FeedTime"
  | "VaultAddress"
  | "TotalSupply"
}
EventName                = { "BridgeAmount" | "OID" }
ChainFunctionName        = { "LatestBlock" | "LatestTimestamp" | "Balance" }
RpcFunctionName          = { "VaultBalance" | "ApiHeight" | "BTCHeight" }
NotificationFunctionName = { "Send" }

Params = { "(" ~ (Expr ~ ("," ~ Expr)*)? ~ ")" }

Identifier    = @{ ASCII_ALPHANUMERIC ~ (ASCII_ALPHANUMERIC | "_" | "/")* }
Number        = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
Address       = @{ "0x" ~ ASCII_HEX_DIGIT+ }
StringLiteral = @{ "'" ~ ((!"'" ~ ANY)*) ~ "'" }

// expression
RpcFunctionCallExpr    = { Service ~ "." ~ RpcFunctionName ~ Params }
ContractMethodCallExpr = { Chain ~ "." ~ Service ~ "." ~ Contract ~ "." ~ ContractMethodName ~ Params }
EventCallExpr          = { Chain ~ "." ~ Service ~ "." ~ Contract ~ "." ~ EventName ~ Params }
ChainFunctionCallExpr  = { Chain ~ "." ~ ChainFunctionName ~ Params }
NotificationCallExpr   = { Notification ~ "." ~ NotificationFunctionName ~ Params }

// Statements
CallStmt       = { RpcFunctionCallExpr | ContractMethodCallExpr | EventCallExpr | ChainFunctionCallExpr | NotificationCallExpr }
AssignmentStmt = { WHITESPACE? ~ Identifier ~ "=" ~ Expr ~ ";" ~ WHITESPACE? }
ExprStmt       = { WHITESPACE? ~ Expr ~ ";" ~ WHITESPACE? }

// Program
Program = { (AssignmentStmt | ExprStmt)+ }
